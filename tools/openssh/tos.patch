+/* tOS: the privilege separation account (uid 74) is used even when /etc/passwd has no line for it */
+struct passwd *
+tos_privsep_pw(const char *name)
+{
+	static struct passwd fake;
+	struct passwd *pw = getpwnam(name);
+
+	if (pw != NULL)
+		return pw;
+	memset(&fake, 0, sizeof(fake));
+	fake.pw_name = (char *)name;
+	fake.pw_passwd = (char *)"*";
+	fake.pw_uid = 74;
+	fake.pw_gid = 74;
+	fake.pw_gecos = (char *)"sshd privilege separation";
+	fake.pw_dir = (char *)"/system/pkg/openssh/var/empty";
+	fake.pw_shell = (char *)"/bin/false";
+	return &fake;
+}
+
 struct passwd *
 pwcopy(struct passwd *pw)
 {
