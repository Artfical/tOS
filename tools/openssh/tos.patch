-	copy->pw_shell = xstrdup(pw->pw_shell == NULL ? "" : pw->pw_shell);
+	/* tOS: every account's shell is the one tOS's openssh package carries (tOS's own is not a file) */
+	copy->pw_shell = xstrdup("/system/pkg/openssh/bin/sh");
 	return copy;
 }
 
